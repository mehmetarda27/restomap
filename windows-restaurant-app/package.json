{
  "name": "restomap-restaurant-windows",
  "version": "1.2.0",
  "description": "RESTOMAP restoran Windows uygulaması",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "test": "node --test printer-service.test.js",
    "test:render": "electron print-render-smoke.js"
  },
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "tr.com.restomap.restaurant",
    "productName": "RESTOMAP Restoran",
    "artifactName": "RESTOMAP-Restoran-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "printer-service.js",
      "offline.html",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "assets/restomap.ico"
    },
    "portable": {
      "artifactName": "RESTOMAP-Restoran.exe"
    }
  }
}
