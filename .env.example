NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://app.deliveraexpress.com
TRUST_PROXY=true
FORCE_HTTPS=true
RESTOMAP_CORS_ORIGINS=https://app.deliveraexpress.com

# Production notu:
# Gercek ortamlarda secret'lari bu dosyada tutma; hosting secret manager,
# Docker/Kubernetes secret veya CI/CD protected variable kullan.

# Python platform worker -> Node receiver.
# Use the same value in Node and platform_worker.py environments.
RESTOMAP_INTEGRATION_KEY=change-this-long-random-secret
RESTOMAP_API_BASE_URL=https://paketdelivera.onrender.com
WEBHOOK_SECRET=
WEBHOOK_ENABLED=true
WEBHOOK_LOG_ENABLED=true
WEBHOOK_ALLOWED_IPS=
RESTOMAP_MAX_REQUEST_BODY_BYTES=1048576
# Production /metrics endpoint requires this token. Keep it in the secret manager.
RESTOMAP_METRICS_TOKEN=change-this-metrics-token
# Never enable in production. Development reset tokens are already returned by the API.
RESTOMAP_LOG_PASSWORD_RESET_TOKENS=false
DATABASE_URL=postgres://delivera:password@host:5432/delivera
POSTGRES_PASSWORD=change-this-postgres-password
PGPOOL_MAX=5
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=10000
# Local development fallback only. NODE_ENV=production requires DATABASE_URL.
# DATABASE_PATH=./restomap.sqlite
# DATABASE_CLIENT=sqlite
RESTOMAP_BACKUP_DIR=./backups
RESTOMAP_UPLOAD_DIR=./uploads
RESTOMAP_WORKER_CACHE_FILE=./processed_orders.db
RESTOMAP_WORKER_POLL_SECONDS=30
RESTOMAP_WORKER_ACCOUNT_DELAY_SECONDS=1.2

# Ilk admin hesabini sabitlemek istersen doldur.
RESTOMAP_ADMIN_USERNAME=admin
RESTOMAP_ADMIN_PASSWORD=StrongAdminPassword123!

# Trendyol credential verify icin stage kullanacaksan ac.
TRENDYOL_STAGE_MODE=false
TRENDYOL_TOKEN_URL=
TRENDYOL_ORDERS_URL=
GETIR_TOKEN_URL=
GETIR_ORDERS_URL=
YEMEKSEPETI_TOKEN_URL=
YEMEKSEPETI_ORDERS_URL=
MIGROS_TOKEN_URL=
MIGROS_ORDERS_URL=

# FastSiparis / Posentegra Web API.
# Base URL ve API key verilirse admin restoran create akisi Posentegra'da
# restoran olusturur, donen id'yi restaurants.posentegra_id alanina yazar.
# Ornek: https://api.v1.fastsiparis.com veya https://api.v1.fastsiparis.com/web-api/v1
# Uygulama /web-api/v1 tekrarini otomatik olarak engeller.
POSENTEGRA_API_BASE_URL=
POSENTEGRA_API_KEY=
POSENTEGRA_BUSINESS_ID=
POSENTEGRA_REQUEST_TIMEOUT_MS=8000
POSENTEGRA_RETRY_ATTEMPTS=3
POSENTEGRA_RETRY_DELAY_MS=500
POSENTEGRA_OUTBOX_POLL_MS=10000
POSENTEGRA_INBOUND_SYNC_INTERVAL_MS=30000

# POS/Adisyo order polling ayarlari.
ADISYO_API_BASE_URL=
ADISYO_POLLING_PATH=/integration/order/sellers/{sellerId}/orders
ADISYO_VERIFY_URL=
ADISYO_POLLING_URL=

# Diger partnerler icin opsiyonel verify endpointleri.
# RESTOMAP_VERIFY_URL_GETIRYEMEK=https://partner.example.com/health
# RESTOMAP_VERIFY_URL_YEMEKSEPETI=https://partner.example.com/health
# RESTOMAP_VERIFY_URL_MIGROS_YEMEK=https://partner.example.com/health
# Baglanti saglik kontrolu icin opsiyonel provider health endpointleri.
# RESTOMAP_HEALTH_URL_GETIR_YEMEK=https://partner.example.com/health
# RESTOMAP_HEALTH_URL_YEMEKSEPETI=https://partner.example.com/health
# RESTOMAP_HEALTH_URL_MIGROS_YEMEK=https://partner.example.com/health

# Platform status callback endpointleri. Platform hesabinda callback URL varsa
# once o kullanilir; yoksa platforma ozel env, sonra global fallback denenir.
# RESTOMAP_PLATFORM_CALLBACK_URL=https://partner.example.com/delivera/status
# PLATFORM_CALLBACK_URL=https://partner.example.com/delivera/status
# RESTOMAP_PLATFORM_CALLBACK_URL_YEMEKSEPETI=https://partner.example.com/yemeksepeti/status
# RESTOMAP_PLATFORM_CALLBACK_URL_GETIR_YEMEK=https://partner.example.com/getir/status
# RESTOMAP_PLATFORM_CALLBACK_URL_TRENDYOL_YEMEK=https://partner.example.com/trendyol/status
# RESTOMAP_PLATFORM_CALLBACK_URL_MIGROS_YEMEK=https://partner.example.com/migros/status

# Postgres canli ortam notu:
# DATABASE_URL varsa uygulama PostgreSQL kullanir. NODE_ENV=production ortaminda
# DATABASE_URL yoksa uygulama baslamaz; SQLite sadece local development fallback'tir.

# Redis hedefli canli ortam notu:
# REDIS_URL verilirse rate-limit Redis store'a baglanmayi dener; baglanamazsa memory fallback kullanir.
# BullMQ queue REDIS_URL ile aktif olur; worker ayri process olarak `npm run worker` ile calistirilir.
REDIS_URL=
# Docker/production readiness kontrolünde Redis kuyruğunu zorunlu tutar.
# Redis servisi hazir olmadan true yapma. False iken sistem inline kuyrukla
# calisir ve /ready Redis eksigini uyari olarak raporlar.
RESTOMAP_REQUIRE_REDIS=false

# Loglama:
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
GOOGLE_MAPS_EMBED_API_KEY=
# Koordinatsiz teslimat adreslerini harita on izlemesi icin otomatik cozer.
GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
GEOCODING_COUNTRY_CODES=tr
GEOCODING_USER_AGENT=RESTOMAP/1.0 (delivery address preview)

# RESTOMAP Paket mobil uygulama bildirimleri icin opsiyonel Firebase hazirligi.
# Android tarafinda FCM acilacaksa android/app/google-services.json dosyasi
# Firebase Console'dan indirilmeli ve bu degerler canli ortam secret'larinda tutulmali.
FCM_PROJECT_ID=
FCM_VAPID_PUBLIC_KEY=
FCM_SERVICE_ACCOUNT_JSON=

# Platform webhook signature placeholder'lari:
# Gercek secretlari .env.example icine yazma; platform hesap ekraninda veya secret manager'da sakla.
# X-Platform-Signature / X-Webhook-Signature HMAC-SHA256 hex beklenir.

# Platform polling varsayilan olarak kapali kalir. Worker/queue yokken
# canlida webhook akisi tercih edilir.
RESTOMAP_PLATFORM_POLLING_ENABLED=false
RESTOMAP_PLATFORM_POLLING_INTERVAL_MS=30000

# Operasyonel takip:
# Her HTTP yanitta X-Request-Id doner; upstream proxy varsa kendi
# X-Request-Id degerini gonderebilir.

# Guvenli load smoke varsayilanlari.
# DATABASE_URL varsa PostgreSQL'e load_ prefix'li idempotent test verisi ekler.
# Production'da bunu acmak icin RESTOMAP_ALLOW_PRODUCTION_LOAD_SEED=1 gerekir.
LOAD_RESTAURANTS=50
LOAD_COURIERS=100
LOAD_PACKAGES=300
LOAD_CONCURRENCY=5,10
# Online kuryenin GPS kaydi en fazla 30 dakika eski olabilir.
RESTOMAP_COURIER_LOCATION_FRESHNESS_MS=1800000

# Telegram operasyon gozcusu. Token ve chat kimligi sadece Render secret
# alaninda tutulmalidir; repoya veya loglara yazilmaz.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
RESTOMAP_SUPERVISOR_ENABLED=true
RESTOMAP_SUPERVISOR_INTERVAL_MS=60000
RESTOMAP_WAITING_ALERT_MINUTES=5
RESTOMAP_ACCEPTED_ALERT_MINUTES=20
RESTOMAP_ROUTE_ALERT_MINUTES=60
RESTOMAP_STALE_LOCATION_ALERT_MINUTES=30
RESTOMAP_ALERT_REPEAT_MINUTES=60
# Europe/Istanbul saatine gore 0-23.
RESTOMAP_DAILY_REPORT_HOUR=9
# Onceki gunun kapanis raporu; vardiya veya paket durumunu degistirmez.
RESTOMAP_DAY_CLOSE_REPORT_HOUR=0
RESTOMAP_DAY_CLOSE_REPORT_MINUTE=5
# Veritabani, kuyruk, webhook, platform ve Posentegra outbox kontrol araligi.
RESTOMAP_HEALTH_CHECK_INTERVAL_MS=300000
# Yalniz TELEGRAM_ALERT_CHAT_ID komut verebilir. Silme/teslim komutu yoktur.
TELEGRAM_COMMAND_POLL_MS=5000
TELEGRAM_REQUEST_TIMEOUT_MS=8000
TELEGRAM_SEND_ATTEMPTS=3
